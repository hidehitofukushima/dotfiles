#!/usr/bin/env zsh
# ~/bin/newproj
# Usage: newproj [project_name]

set -e

# --- プロジェクト名を取得 ---
if [[ -z "$1" ]]; then
  vared -p "新しいプロジェクト名を入力してください: " -c PROJECT_NAME
else
  PROJECT_NAME="$1"
fi

# 空入力チェック
if [[ -z "$PROJECT_NAME" ]]; then
  echo "❌ プロジェクト名が空です。"
  exit 1
fi

# --- テンプレートと宛先を設定 ---
TEMPLATE="$HOME/dotfiles/template_shirokane/"
DEST="$HOME/Projects/$PROJECT_NAME"
PARENT_DIR="$(dirname "$DEST")"

if [[ -d "$DEST" ]]; then
  echo "⚠️  既に存在します: $DEST"
  exit 1
fi

# --- コピーして移動 ---
mkdir -p "$PARENT_DIR"
cp -r "$TEMPLATE" "$DEST"

