#!/usr/bin/env zsh
# Usage: newproj [project_name]
# 統合版。local / shirokane を fzf で選択。

set -e

# --- プロジェクト名を取得 ---
if [[ -z "$1" ]]; then
  vared -p "新しいプロジェクト名を入力してください: " -c PROJECT_NAME
else
  PROJECT_NAME="$1"
fi

# 空入力チェック
if [[ -z "$PROJECT_NAME" ]]; then
  echo "Error: プロジェクト名が空です。"
  exit 1
fi

# --- モード選択（fzfで切り替え） ---
if ! command -v fzf >/dev/null 2>&1; then
  echo "Error: fzf が見つかりません。"
  exit 127
fi

MODE=$(
  printf "%s\n" \
    "local     -> ~/Desktop/Projects/" \
    "shirokane -> ~/Projects/" \
  | fzf \
      --prompt="作成モード> " \
      --height=40% \
      --layout=reverse \
      --border
) || exit 0

# fzfの選択結果から先頭のモード名だけ取り出す
MODE="${MODE%% *}"

case "$MODE" in
  local)
    TEMPLATE="$HOME/dotfiles/template/local/"
    DEST_BASE="$HOME/Desktop/Projects"
    ;;
  shirokane)
    TEMPLATE="$HOME/dotfiles/template/shirokane/"
    DEST_BASE="$HOME/Projects"
    ;;
  *)
    echo "Error: 不正な選択です。"
    exit 1
    ;;
esac

# --- 宛先を設定 ---
DEST="$DEST_BASE/$PROJECT_NAME"
PARENT_DIR="$(dirname "$DEST")"

if [[ -d "$DEST" ]]; then
  echo "Warning: 既に存在します: $DEST"
  exit 1
fi

# --- コピー ---
mkdir -p "$PARENT_DIR"
cp -r "$TEMPLATE" "$DEST"

echo "[${MODE}] プロジェクトを作成しました: $DEST"
