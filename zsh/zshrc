# Ghostty shell integration for Bash. This should be at the top of your bashrc!
if [ -n "${GHOSTTY_RESOURCES_DIR}" ]; then
    builtin source "${GHOSTTY_RESOURCES_DIR}/shell-integration/zsh/ghostty-integration"
fi

alias s1='ssh s1'
alias s2='ssh s2'
alias s3='ssh s3'
alias s4='ssh s4'
alias s5='ssh s5'

alias lg='lazygit'
alias j='nvim'
alias t='tmux'
alias tk='tmux kill-server'

# /usr/local/package/nodejs/20.10.0/bin/npm
export PATH="/usr/local/package/nodejs/20.10.0/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"  # pipx でインストールしたコマンド用
export PATH="$HOME/.local/scripts:$PATH"
export PATH="$HOME/.config/tmux-sessionizer:$PATH"
export PATH="$HOME/.fzf/bin:$PATH"
bindkey -s ^f "tmux-sessionizer\n"
bindkey -s ^s "source ~/.zshrc\n"
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git)
source $ZSH/oh-my-zsh.sh

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
if [ -f ~/.fzf.zsh ]; then
  source ~/.fzf.zsh
fi

